# Backend
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/context_rot
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development

# Internal-service authentication. Development defaults to unauthenticated
# when API_KEY is unset; non-development environments fail closed unless
# API_KEY is configured. Set AUTH_ENABLED=true to require it explicitly in
# development, or AUTH_ENABLED=false only for a deliberately local setup.
# API_KEY=
# AUTH_ENABLED=
# ANALYSIS_RATE_LIMIT_PER_MINUTE=60

# Optional: semantic/LLM analysis (Phase 5). If LLM_API_KEY is unset, the
# app falls back to a safe no-op provider and only deterministic signals
# are produced -- an LLM key is never required to run the app.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF_SECONDS=0.25
# LLM_MAX_CALLS_PER_ANALYSIS=24

# Optional: context-health scoring weights (Phase 6). All default to
# sensible values (equal 1.0 dimension weights, 0.15 penalty per signal)
# -- override only to tune how harshly a dimension or an individual
# signal affects the overall score, without changing detector code.
# HEALTH_PENALTY_PER_SIGNAL=0.15
# HEALTH_WEIGHT_CONSISTENCY=1.0
# HEALTH_WEIGHT_INSTRUCTION_ADHERENCE=1.0
# HEALTH_WEIGHT_INFORMATION_RETENTION=1.0
# HEALTH_WEIGHT_RELEVANCE=1.0
# HEALTH_WEIGHT_TOOL_UTILIZATION=1.0
# HEALTH_WEIGHT_HALLUCINATION_RISK=1.0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
