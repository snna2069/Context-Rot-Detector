# Backend
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/context_rot
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development

# Optional: semantic/LLM analysis (Phase 5). If LLM_API_KEY is unset, the
# app falls back to a safe no-op provider and only deterministic signals
# are produced -- an LLM key is never required to run the app.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=20

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
